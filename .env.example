# Copy to .env.local (local) or set in your host's dashboard (production).
# Anything left blank is shown on the site as "not connected yet", never faked.

# Public site address including any base path, used for canonicals, sitemap and Open Graph.
SITE_URL=https://example.com

# Brand name shown across the site. The brief says "AI Game Makers Academy";
# the Skool group and the logo currently say "AI Game Makers Club".
BRAND_NAME=AI Game Makers Academy

# Skool. The community URL below is the live group (checked 14 Nov 2026).
# Before launch, confirm the group is set to FREE to join.
SKOOL_COMMUNITY_URL=https://www.skool.com/build-pixel-art-games-with-ai-7131
# Booking page for the free 30-minute concept call. Blank = the default in src/config/site.ts.
CONCEPT_CALL_URL=
# The direct Skool link where the mentorship is bought. Blank = the
# purchase buttons show a disabled "checkout not connected" state.
SKOOL_MENTORSHIP_PURCHASE_URL=

# Contact address shown on the site and used by "Ask a question".
CONTACT_EMAIL=

# Legal identity for the privacy policy (the data controller). Blank = the
# legal pages show a visible "being finalised" notice.
LEGAL_CONTROLLER_NAME=
LEGAL_CONTROLLER_LOCATION=

# Videos: YouTube video IDs (privacy-enhanced youtube-nocookie embeds).
# Blank = branded placeholder thumbnail saying the video is coming.
FOUNDER_VIDEO_ID=
COMMUNITY_VIDEO_ID=
MENTORSHIP_VIDEO_ID=
INTEREST_VIDEO_ID=

# Forms (interest list + workshops). The site is static (GitHub Pages), so the
# browser posts JSON straight to this public endpoint, e.g. a Formspree form
# URL https://formspree.io/f/xxxxxxx. Blank = forms validate but answer
# "sign-ups aren't open yet, nothing was saved" (no fake success).
FORM_ENDPOINT=

# GitHub Pages: the workflow fills these automatically. Locally, set
# NEXT_PUBLIC_BASE_PATH=/ai-game-makers to test the Pages paths.
NEXT_PUBLIC_BASE_PATH=
# Analytics. Supported: "plausible" or blank. Loads only after cookie consent.
ANALYTICS_PROVIDER=
PLAUSIBLE_DOMAIN=

# Google Search Console HTML-tag verification token (content="..." value).
GOOGLE_SITE_VERIFICATION=
